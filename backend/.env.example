# Copy to backend/.env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://servicedesk:servicedesk@localhost:5432/servicedesk
REDIS_URL=redis://localhost:6379/0
# true = run Celery tasks inline (handy for tests/debugging)
CELERY_TASK_ALWAYS_EAGER=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resolved_tickets

# LLM: any OpenAI-compatible endpoint. Default = Groq with open-weight models.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b

EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_THRESHOLD=0.5
